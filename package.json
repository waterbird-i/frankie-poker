{
  "name": "frankie-poker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:local": "esbuild scripts/test-local-practice.ts --bundle --platform=node --format=esm --outfile=.tournament/test-local-practice.mjs --log-level=error && node .tournament/test-local-practice.mjs",
    "test:connection": "esbuild scripts/test-ai-connection.ts --bundle --platform=node --format=esm --outfile=.tournament/test-ai-connection.mjs --log-level=error && node .tournament/test-ai-connection.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tournament": "esbuild scripts/tournament.ts --bundle --platform=node --format=esm --outfile=.tournament/tournament.mjs --log-level=error && node --env-file=.env.local .tournament/tournament.mjs",
    "test:variables": "esbuild scripts/test-variables.ts --bundle --platform=node --format=esm --outfile=.tournament/test-variables.mjs --log-level=error && node .tournament/test-variables.mjs",
    "test:table": "esbuild scripts/test-table.ts --bundle --platform=node --format=esm --outfile=.tournament/test-table.mjs --log-level=error && node .tournament/test-table.mjs",
    "test:multiplayer": "esbuild scripts/test-multiplayer.ts --bundle --platform=node --format=esm --packages=external --outfile=.tournament/test-multiplayer.mjs --log-level=error && node .tournament/test-multiplayer.mjs",
    "test:browser": "node scripts/smoke-browser.mjs",
    "server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=.server/server.mjs --log-level=error && node .server/server.mjs",
    "pack:server": "npm run build && esbuild server/index.ts --bundle --platform=node --target=node18 --format=esm --packages=external --outfile=.server/server.mjs --log-level=error && node scripts/pack-server.mjs"
  },
  "dependencies": {
    "@lobehub/icons": "^5.23.0",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "matter-js": "0.19.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
